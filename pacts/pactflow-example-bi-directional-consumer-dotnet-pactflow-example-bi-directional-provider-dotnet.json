{
  "consumer": {
    "name": "pactflow-example-bi-directional-consumer-dotnet"
  },
  "interactions": [
    {
      "description": "a request to retrieve a product id that does not exist",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/Products/10"
      },
      "response": {
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "status": 404
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to retrieve a product with existing id",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/Products/27"
      },
      "response": {
        "body": {
          "content": {
            "id": 27,
            "name": "burger",
            "type": "food"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request to retrieve all products",
      "pending": false,
      "request": {
        "method": "GET",
        "path": "/Products"
      },
      "response": {
        "body": {
          "content": [
            {
              "id": 27,
              "name": "burger",
              "type": "food"
            }
          ],
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json; charset=utf-8"
          ]
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
    "pactRust": {
      "ffi": "0.4.27",
      "models": "1.2.8"
    },
    "pactSpecification": {
      "version": "4.0"
    }
  },
  "provider": {
    "name": "pactflow-example-bi-directional-provider-dotnet"
  }
}